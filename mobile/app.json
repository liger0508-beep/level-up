{
  "expo": {
    "name": "Level-Up",
    "slug": "gla-coach-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.glacoach.app",
      "infoPlist": {
        "NSCameraUsageDescription": "스윙 영상 촬영 및 QR 출석 스캔을 위해 카메라 접근 권한이 필요합니다.",
        "NSPhotoLibraryUsageDescription": "스윙 영상 및 분석 자료 업로드를 위해 사진 보관함 접근 권한이 필요합니다.",
        "NSPhotoLibraryAddUsageDescription": "촬영한 스윙 영상 및 자료 저장을 위해 사진 보관함 접근 권한이 필요합니다.",
        "NSMicrophoneUsageDescription": "스윙 영상 촬영 시 음성 녹음 및 음성 안내 기능을 위해 마이크 접근 권한이 필요합니다.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.glacoach.app",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#011B55",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "504f1584-80c6-45a0-b076-fbf7e03d2cde"
      }
    },
    "plugins": [
      "expo-font",
      "expo-notifications"
    ]
  }
}
